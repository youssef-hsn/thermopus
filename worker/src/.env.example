# ========================
# DS18B20 Worker Settings
# ========================

# One 1-Wire bus per GPIO pin (BCM numbering). Comma-separated.
# If you only use the default kernel bus on GPIO 4, leave as "4".
WORKER_PINS=4,17,22

# Intervals can be in seconds (e.g. "5") or compound (e.g. "1m30s", "500ms")
WORKER_SCAN_INTERVAL=5s
WORKER_READ_INTERVAL=2s
WORKER_READ_TIMEOUT=1s
WORKER_FRESHNESS_WINDOW=10s

# Prometheus exporter HTTP port
WORKER_METRICS_PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR
WORKER_LOG_LEVEL=INFO

# Use inotify instead of polling for hot-plug detection (Linux only)
WORKER_USE_INOTIFY=false

# Optional: friendly labels for sensors (ROM → name) as JSON
# Example: {"28-00000abcdef0":"TankInlet","28-00000fedcba":"RoofProbe3"}
WORKER_LABEL_MAP={"28-00000abcdef0":"TankInlet","28-00000fedcba":"RoofProbe3"}

# Optional: disable specific sensors at startup (JSON array)
# Example: ["28-00000deadbeef","28-00000cafebabe"]
WORKER_DISABLED_ROMS=[]
